NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
# Local MongoDB example. Use your Atlas connection string for a hosted database.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=decidemate
MONGODB_MAX_POOL_SIZE=20
# Required in production; generate a random value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying

# Required for Gemini to answer decision questions. Keep this key private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional SMTP settings for password reset emails. In development without SMTP,
# reset links are logged to the API console and shown in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
